        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n  subgraph M[\&quot;Модератор\&quot;]\n    direction LR\n    m_start((\&quot;Новий коментар у черзі модерації\&quot;)) --&gt; m_open(\&quot;Відкрити чергу модерації\&quot;)\n    m_open -.-&gt; m_queue[(\&quot;Черга модерації\&quot;)]\n    m_open --&gt; m_read(\&quot;Прочитати коментар і репутацію користувача\&quot;)\n    m_read -.-&gt; m_profile[/\&quot;Профіль користувача\&quot;/]\n    m_read --&gt; m_log(\&quot;Зробити запис у журналі модерації\&quot;)\n    m_log -.-&gt; m_journal[(\&quot;Журнал модерації\&quot;)]\n    m_log --&gt; m_dec{\&quot;Рішення модератора?\&quot;}\n    m_dec --&gt;|схвалити| m_approved((\&quot;Схвалено\&quot;))\n    m_dec --&gt;|приховати| m_hidden((\&quot;Приховано\&quot;))\n    m_dec --&gt;|видалити| m_warn(\&quot;Видалити коментар і надіслати попередження\&quot;)\n    m_warn --&gt; m_event{\&quot;Очікування події\&quot;}\n    m_event --&gt; m_complaint((\&quot;Надійшла нова скарга на користувача\&quot;))\n    m_complaint --&gt; m_block(\&quot;Заблокувати користувача\&quot;)\n    m_block -.-&gt; m_users[(\&quot;Користувачі\&quot;)]\n    m_block --&gt; m_blocked((\&quot;Користувача заблоковано\&quot;))\n    m_event --&gt; m_timer((\&quot;Минуло 30 днів без нових порушень\&quot;))\n    m_timer --&gt; m_no_repeat((\&quot;Повторного порушення немає, попередження знято\&quot;))\n  end\n\n  subgraph S[\&quot;Система\&quot;]\n    direction LR\n    s1[\&quot;Обробка черги\&quot;]\n    s2[\&quot;Фіксація результатів\&quot;]\n  end\n\n  subgraph U[\&quot;Користувач\&quot;]\n    direction LR\n    u_warning((\&quot;Отримано попередження\&quot;))\n  end\n\n  m_warn -.-&gt;|Повідомлення| u_warning\n  s1 -.-&gt; m_open\n  m_log -.-&gt; s2\n\n  class m_start,m_approved,m_hidden,m_complaint,m_timer,m_blocked,m_no_repeat,u_warning event\n  class m_open,m_read,m_log,m_warn,m_block,s1,s2 task\n  class m_dec,m_event gateway\n  class m_queue,m_profile,m_journal,m_users data\n  style M fill:#f4f4f4,stroke:#555,stroke-width:1px\n  style S fill:#f4f4f4,stroke:#555,stroke-width:1px\n  style U fill:#f4f4f4,stroke:#555,stroke-width:1px\n  linkStyle 20 stroke:#333,stroke-width:1px,stroke-dasharray:5 5&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="46">
